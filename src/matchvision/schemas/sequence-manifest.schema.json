{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MatchVision sequence manifest schema",
  "type": "object",
  "required": ["manifest_version", "dataset", "release", "sequences"],
  "properties": {
    "manifest_version": {"const": 1},
    "dataset": {"type": "string", "minLength": 1},
    "release": {"type": "string", "minLength": 1},
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["game_id", "sequence_id", "split", "video_path", "annotation_path", "frame_count", "fps", "width", "height"],
        "properties": {
          "game_id": {"type": "string", "minLength": 1},
          "sequence_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "split": {"enum": ["train", "validation", "test", "challenge"]},
          "video_path": {"type": "string", "minLength": 1},
          "annotation_path": {"type": "string", "minLength": 1},
          "frame_count": {"type": "integer", "minimum": 1},
          "fps": {"type": "number", "exclusiveMinimum": 0},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "video_sha256": {"$ref": "#/$defs/sha256"},
          "annotation_sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
  },
  "additionalProperties": false
}
