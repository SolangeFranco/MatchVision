{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MatchVision benchmark configuration schema",
  "type": "object",
  "required": ["experiment", "runtime", "detectors", "trackers", "evaluation", "outputs"],
  "properties": {
    "experiment": {
      "type": "object",
      "required": ["name", "status", "random_seed", "dataset"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["planned", "ready"]},
        "random_seed": {"type": "integer", "minimum": 0},
        "dataset": {
          "type": "object",
          "required": ["name", "release", "split", "sequence_manifest", "sequence_hashes_required", "split_by", "frame_policy", "smoke_test_frames"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "release": {"type": "string", "minLength": 1},
            "split": {"enum": ["train", "validation", "test", "challenge"]},
            "sequence_manifest": {"type": "string", "minLength": 1},
            "sequence_hashes_required": {"type": "boolean"},
            "split_by": {"const": "match"},
            "frame_policy": {"enum": ["full_sequence"]},
            "smoke_test_frames": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": ["source_resolution", "preprocessing", "device", "batch_size", "warmup_runs", "timed_repeats"],
      "properties": {
        "source_resolution": {"enum": ["preserve"]},
        "preprocessing": {"enum": ["letterbox"]},
        "device": {"type": "string", "minLength": 1},
        "batch_size": {"type": "integer", "minimum": 1},
        "warmup_runs": {"type": "integer", "minimum": 0},
        "timed_repeats": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "detectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["family", "checkpoint", "pretrained_on"],
        "properties": {
          "family": {"type": "string", "minLength": 1},
          "checkpoint": {"type": "string", "minLength": 1},
          "pretrained_on": {"type": "string", "minLength": 1},
          "version": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "trackers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["family", "input"],
        "properties": {
          "family": {"type": "string", "minLength": 1},
          "input": {"const": "cached_detector_outputs"},
          "reid": {"type": "string"},
          "reid_checkpoint": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["tracking_metrics", "detection_metrics", "performance_metrics"],
      "properties": {
        "tracking_metrics": {"type": "array", "items": {"type": "string"}},
        "detection_metrics": {"type": "array", "items": {"type": "string"}},
        "performance_metrics": {"type": "array", "items": {"type": "string"}},
        "caveat": {"type": "string"}
      },
      "additionalProperties": true
    },
    "outputs": {
      "type": "object",
      "required": ["directory", "save_detections", "save_predictions", "save_environment_and_hashes"],
      "properties": {
        "directory": {"type": "string", "minLength": 1},
        "save_detections": {"type": "boolean"},
        "save_predictions": {"type": "boolean"},
        "save_environment_and_hashes": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
